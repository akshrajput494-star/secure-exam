# === Secure Exam Environment Configuration ===

# Application
APP_ENV=dev

# Database
DATABASE_URL=postgresql+asyncpg://secure_exam:local_dev_password_change_me@localhost:5432/secure_exam

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# AWS KMS (leave empty for local dev mock)
AWS_KMS_KEY_ID=
AWS_REGION=ap-south-1

# Authentication
JWT_SECRET_KEY=change-this-to-a-random-64-char-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=30

# Storage
BLOB_STORAGE_PATH=./storage/encrypted_exams
# S3_BUCKET=secure-exam-blobs  # Uncomment for AWS S3

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Rate Limiting
RATE_LIMIT=100/minute
